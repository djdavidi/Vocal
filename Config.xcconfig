PRODUCT_NAME = Vocal
PRODUCT_BUNDLE_IDENTIFIER = com.david.vocal.prototype
MARKETING_VERSION = 0.1
CURRENT_PROJECT_VERSION = 1
CODE_SIGN_STYLE = Automatic
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_NSMicrophoneUsageDescription = Listen to spoken messages for local conversation. Audio is not recorded to disk.
INFOPLIST_KEY_NSSpeechRecognitionUsageDescription = Transcribe your speech locally for the offline conversation prototype.
INFOPLIST_KEY_UILaunchScreen_Generation = YES
INFOPLIST_KEY_UIApplicationSceneManifest_Generation = YES
INFOPLIST_KEY_UISupportedInterfaceOrientations = UIInterfaceOrientationPortrait
TARGETED_DEVICE_FAMILY = 1
SUPPORTED_PLATFORMS = iphoneos
SUPPORTS_MACCATALYST = NO
SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD = NO
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks
